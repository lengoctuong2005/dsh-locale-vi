{
  "name": "dsh-locale-vi",
  "version": "1.0.0",
  "description": "Vietnamese (Ti\u1ebfng Vi\u1ec7t) language pack for DeepSeek Harness Web UI",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "locale",
    "i18n",
    "vietnamese",
    "tieng-viet"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}